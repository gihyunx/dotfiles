shell-integration = fish
command = fish -l

font-family = Iosevka
font-size = 16
font-feature = -calt

resize-overlay = never
confirm-close-surface = false
window-decoration = none

keybind = clear

adjust-box-thickness = -1

background = #141313
foreground = #bcb8bc
background-opacity = 1.00
background-opacity-cells = true
gtk-single-instance = true

shell-integration-features = no-cursor

cursor-style = block
cursor-style-blink = false
cursor-color = #c6c2c6
cursor-text = #181111

# Selection
selection-background = #7D8092
selection-foreground = #151414

# Color Palette (regular 0-7 + bright 8-15)
# 
# black
# red
# green
# yellow
# blue
# magenta
# cyan
# white

palette = 0=#181212
palette = 1=#b97ea1
palette = 2=#7dc3ae
palette = 3=#e4c18d
palette = 4=#a18198
palette = 5=#e6bdbb
palette = 6=#ccaac5
palette = 7=#bcb8bc

palette = 8=#8F8898
palette = 9=#b97ea1
palette = 10=#7dc3ae
palette = 11=#e4c18d
palette = 12=#a18198
palette = 13=#e6bdbb
palette = 14=#ccaac5
palette = 15=#bcb8bc


# palette = 0=#1d0c1d
# palette = 1=#f38ba8
# palette = 2=#7dc3ae
# palette = 3=#7D8092
# palette = 4=#8F8898
# palette = 5=#AB9BA4
# palette = 6=#ffb3b2
# palette = 7=#c6c2c6
#
# palette = 8=#705c70
